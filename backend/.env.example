DEVICE_TOKEN=replace-with-existing-device-token-at-least-32-characters
SESSION_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
DASHBOARD_PASSWORD=choose-a-login-password-at-least-16-characters
# Required on Vercel for Pub/Sub across socket connections on different instances.
# Use the Redis TCP/TLS URL, not an HTTPS REST endpoint.
REDIS_URL=rediss://default:password@your-redis-host:6379

# Required for AI chat. Keep this server-side; leave empty for LED-only use.
OPENAI_API_KEY=
# Optional: override the Agents SDK's default model with one your project can use.
OPENAI_MODEL=
